---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/forms/ContactForm.astro';
---
<Base title="Contact" description="Get in touch with Javelin Fund.">
  <section class="container contact-page">
    <div>
      <p class="eyebrow gold">Contact</p>
      <h1 class="display" style="font-size:54px;letter-spacing:-2px;margin:0 0 16px">
        Drop us a line.
      </h1>
      <p class="lede">
        For partnership, press, volunteering or general questions, drop us a line. We reply within 3 business days.
      </p>
      <p class="meta">
        <strong>Email:</strong> contact@javelinfund.ca<br />
        <strong>Charity:</strong> BN 755722097 RR0001
      </p>
    </div>
    <ContactForm />
  </section>
</Base>
<style>
  .contact-page {
    padding: 80px 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .gold { color: var(--gold); }
  .lede {
    font-size: 18px;
    color: var(--fg-muted);
    max-width: 480px;
    line-height: 1.55;
  }
  .meta { color: var(--fg-muted); margin-top: 24px; line-height: 1.7; }
  @media (max-width: 880px) {
    .contact-page { grid-template-columns: 1fr; }
  }
</style>
