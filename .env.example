# Public env vars consumed by Astro at build time.
# Copy to .env for local dev (Astro auto-reads .env) or set the same values
# in Cloudflare Pages → Project → Settings → Environment variables
# (apply to Production AND Preview).

# Apps Script Web App URL — receives JSON form POSTs and writes rows to the
# Javelin Fund forms Google Sheet.
PUBLIC_FORMS_ENDPOINT=https://script.google.com/macros/s/AKfycbzdT0tB2KZsfHS4_dkiQF2NBu6k-dr9RDFKEu9OdNQRZ8c9j9IfDtNqtz2SxiNZb8NI/exec
